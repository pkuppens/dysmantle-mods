<?xml version="1.0" encoding="utf-8"?>
<root>

<!-- 

grow_time_minutes refers to the world time which is by default running 20x speed to real world time. So setting the time to 1 minute would take 60/20=3 seconds to grow.
grow_time_minutes_real_time can be used to define the time in real time. This automatically uses the 20x speed multiplier to scale the value.

display_name
description

material_id defined, uses material icon for the seed icon
icon icon for the seed
-->
    
    <array id="SEEDS">
	
        <node id="CARROT" 
		 material_id="CARROT"
		 display_name="Carrot Seed"
		 description="These seeds produce a vegetable with an edible taproot."
		 grow_time_minutes="20"
		 num_materials_required_for_one_plant_seed="1"
		 num_materials_one_plant_drops="2..3"
		 actor_type="actors/interactives/farming-carrot.xml" />

        <node id="TOMATO" 
		 material_id="TOMATO"
		 display_name="Tomato Seed"
		 description="These seeds grow into bushy plants with big edible berries."
		 grow_time_minutes="25"
		 num_materials_required_for_one_plant_seed="1"
		 num_materials_one_plant_drops="3..4"
		 actor_type="actors/interactives/farming-tomato.xml" />
		 
        <node id="LETTUCE" 
		 material_id="LETTUCE"
		 display_name="Lettuce Seed"
		 description="When these vegetable seeds are planted, they eventually grow bushy leaves overground. "
		 grow_time_minutes="35"
		 num_materials_required_for_one_plant_seed="2"
		 num_materials_one_plant_drops="3..4"
		 actor_type="actors/interactives/farming-lettuce.xml" />

		<node id="POTATO" 
		 material_id="POTATO"
		 display_name="Potato Seed"
		 description="These seeds produce an edible 'tuber' underground, the location of which is marked by green leaves overground."
		 grow_time_minutes="40"
		 num_materials_required_for_one_plant_seed="2"
		 num_materials_one_plant_drops="3..5"
		 actor_type="actors/interactives/farming-potato.xml" />	

		<node id="CORN" 
		material_id="CORN"
		display_name="Corn Kernel"
		description="A leafy stalk is produced from these kernels. At the top of the stalk there is a concentration of more kernels called 'an ear'."
		grow_time_minutes="50"
		num_materials_required_for_one_plant_seed="2"
		num_materials_one_plant_drops="4..6"
		actor_type="actors/interactives/farming-corn.xml" />

        <node id="ONION" 
		 material_id="ONION"
		 display_name="Onion Seed"
		 description="After planting these seeds, a stem grows out underground and eventually begins to swell into a round edible 'bulb'."
		 grow_time_minutes="60"
		 num_materials_required_for_one_plant_seed="3"
		 num_materials_one_plant_drops="5..7"
		 actor_type="actors/interactives/farming-onion.xml" />		 

        <node id="WHEAT" 
		 material_id="WHEAT"
		 display_name="Wheat Seed"
		 description="These seeds produce a type of grass with harvestable crops at the end of a long stalk."
		 grow_time_minutes="70"
		 num_materials_required_for_one_plant_seed="3"
		 num_materials_one_plant_drops="5..8"
		 actor_type="actors/interactives/farming-wheat.xml" />		

        <node id="BANANA" 
		 material_id="BANANA"
		 display_name="Banana Seed"
		 description="These seeds grow into plants with big yellow fruits."
		 grow_time_minutes="70"
		 num_materials_required_for_one_plant_seed="3"
		 num_materials_one_plant_drops="4..7"
		 actor_type="actors/interactives/farming-banana-plant.xml" />

        <node id="MANA_BEAD" 
		 material_id="MANA_BEAD"
		 requires_item="items/tools/seed-bag-mana.nut"
		 display_name="Mana Seed"
		 description="Mana seeds that grow into a strange plant with harvestable crops."
		 grow_time_minutes="120"
		 num_materials_required_for_one_plant_seed="1"
		 num_materials_one_plant_drops="4..6"
		 actor_type="actors/interactives/farming-mana-bead.xml" />
		 
    </array>
    
</root>